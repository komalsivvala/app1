{
  "name": "ap-learners-licence-practice",
  "version": "0.0.1",
  "private": true,
  "description": "Offline bilingual (Telugu/English) practice app for the Andhra Pradesh Learner's Licence computer test. Unofficial study aid; not affiliated with any government entity.",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --check .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "validate:config": "node scripts/validate-exam-config.mjs",
    "validate:content": "node scripts/validate-content-config.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:node": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:jest": "jest --ci",
    "test": "npm run validate:config && npm run validate:content && npm run check:i18n && npm run test:scripts && npm run test:node && npm run test:jest",
    "check": "npm run typecheck && npm run lint && npm test",
    "content:ingest": "python3 pipeline/02_ingest_csv.py pipeline/raw/supplied/LLR_Andhra_Pradesh.csv --out pipeline/build/records.json",
    "content:validate": "python3 pipeline/05_validate.py --strict",
    "content:emit": "python3 pipeline/06_emit.py --ts-out src/content/questions.ts",
    "content:test": "python3 pipeline/test_pipeline.py",
    "typecheck:content": "npx --yes -p typescript@5 tsc --noEmit --strict --noUncheckedIndexedAccess --target es2022 --module esnext --skipLibCheck src/content/questions.ts",
    "export:web": "expo export --platform web",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "playwright": "^1.56.1",
    "prettier": "^3.9.8",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
